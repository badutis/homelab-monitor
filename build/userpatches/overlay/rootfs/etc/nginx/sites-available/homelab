# homelab-monitor: one entry point on port 80 (LAN only, see nftables).
#   /           homelable web UI (static files) and its API (127.0.0.1:8000)
#   /grafana/   Grafana (127.0.0.1:3000)
# Until the first boot has configured the box (marker
# /var/lib/homelab-monitor/configured), the backends do not run and every page
# shows /not-configured.html.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    root /opt/homelable/frontend/dist;
    index index.html;
    client_max_body_size 20M;

    error_page 502 503 504 /not-configured.html;
    location = /not-configured.html {
        root /usr/share/homelab/www;
        internal;
    }

    # homelable: status websocket (before /api/ so it takes priority).
    location /api/v1/status/ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Legacy websocket path.
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /grafana/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana Live (websocket).
    location /grafana/api/live/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # homelable single-page app; the not-configured page until the first
    # boot has run (it creates the marker file).
    location / {
        if (!-f /var/lib/homelab-monitor/configured) {
            return 503;
        }
        try_files $uri $uri/ /index.html;
    }
}
