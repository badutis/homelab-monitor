# homelab-monitor configuration.
#
# Copy this file to the FAT boot partition of the flashed SD card as
# "homelab.env" and edit it. On first boot it is validated, moved to
# /etc/homelab/homelab.env (root only) and deleted from the card. If anything
# is wrong, nothing is applied and the reasons are written next to it as
# "homelab.env.error".
#
# Format: KEY=value, one per line; "#" starts a comment. Values may be quoted.
# The file is parsed, never executed.

# --- Required -----------------------------------------------------------------

# Login user (gets sudo without a password; there is no password login).
HOMELAB_USER=admin

# SSH public key(s) for HOMELAB_USER; repeat the line for more keys.
HOMELAB_SSH_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyOnlyReplaceMeWithYourOwnPublicKey00 admin@example.invalid"

# --- Optional -----------------------------------------------------------------

# Host name of this box (one lowercase DNS label). Default: keep the image's.
HOSTNAME=monitor

# Time zone (see /usr/share/zoneinfo). Default: UTC.
TIMEZONE=Europe/Vilnius

# Filesystem UUID of a separate disk (USB SSD) for the metrics database; see
# "blkid". Strongly recommended: without it metrics are written to the SD card.
DATA_DISK_UUID=

# Grafana "admin" password (http://<box>/grafana/), at least 12 characters.
# Empty: generated and stored in /root/homelab-credentials.txt.
GRAFANA_ADMIN_PASSWORD=

# homelable "admin" password (the map at http://<box>/), at least 12
# characters. Empty: generated and stored in /root/homelab-credentials.txt.
HOMELABLE_ADMIN_PASSWORD=

# Networks homelable may scan for devices (nmap); repeat for more. IPv4,
# /16 or smaller. Default: none (scanning starts only when you add one).
#HOMELABLE_SCAN_CIDR=192.0.2.0/24

# Grafana bundled plugins to load in addition to the VictoriaMetrics
# datasource (prometheus), comma separated, e.g. loki,mysql. The others stay
# installed but are not loaded, which saves memory. Default: none.
GRAFANA_PLUGINS=

# How long to keep metrics: months (12) or 90d / 8w / 1y. Default: 1y.
RETENTION=1y

# How often to collect metrics. Default: 30s.
SCRAPE_INTERVAL=30s

# Networks allowed to reach SSH and the web UI; repeat for more. Default:
# all private ranges (10/8, 172.16/12, 192.168/16, fc00::/7, fe80::/10).
#LAN_CIDR=192.0.2.0/24

# Machines to monitor: TARGET=<job> <name> <host:port> [<metrics path>]
#   job   groups targets of the same kind, e.g. "node" for node_exporter
#   name  label shown in Grafana; must be unique
TARGET=node server-1 192.0.2.10:9100
TARGET=node server-2 192.0.2.11:9100
TARGET=controller rack-controller 192.0.2.20:8080 /metrics
